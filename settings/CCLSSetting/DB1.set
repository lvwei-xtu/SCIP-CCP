# SCIP version 9.1.0

# maximal time in seconds to run
# [type: real, advanced: FALSE, range: [0,1e+20], default: 1e+20]
limits/time = 14400

# confidence parameter
# [type: real, advanced: FALSE, range: [0,1], default: 0.1]
reading/cclsreader/epsilon = 0.1

# solving formulation (MILP) using the dominance-based branching where the mixing cuts were also implemented
# [type: bool, advanced: FALSE, range: {TRUE,FALSE}, default: FALSE]
reading/cclsreader/DB = TRUE

# frequency for propagating domains (-1: never, 0: only in root node)
# [type: int, advanced: FALSE, range: [-1,1073741822], default: -1]
constraints/chancecons/propfreq = 1

# maximal number of presolving rounds the constraint handler participates in (-1: no limit)
# [type: int, advanced: TRUE, range: [-1,2147483647], default: 0]
constraints/chancecons/maxprerounds = 1

# frequency for calling separator <mixing> (-1: never, 0: only in root node)
# [type: int, advanced: FALSE, range: [-1,1073741822], default: 10]
separating/mixing/freq = -1

