# SCIP version 9.1.0

# maximal time in seconds to run
# [type: real, advanced: FALSE, range: [0,1e+20], default: 1e+20]
limits/time = 14400

# confidence parameter
# [type: real, advanced: FALSE, range: [0,1], default: 0.1]
reading/cclsreader/epsilon = 0.2

# solving formulation (MILP) using the B&C algorithm with the mixing cuts and the dominance inequalities
# [type: bool, advanced: FALSE, range: {TRUE,FALSE}, default: FALSE]
reading/cclsreader/BASE_DI = TRUE

# solving formulation (MILP) using the B&C algorithm with the mixing cuts and the stronger version of dominance inequalities
# [type: bool, advanced: FALSE, range: {TRUE,FALSE}, default: FALSE]
reading/cclsreader/BASE_sDI = TRUE

# frequency for calling separator <mixing> (-1: never, 0: only in root node)
# [type: int, advanced: FALSE, range: [-1,1073741822], default: 10]
separating/mixing/freq = -1

